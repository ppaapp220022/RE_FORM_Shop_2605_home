# 로컬 실행용 환경 변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
# .env 는 application.properties 의 spring.config.import 로 자동으로 읽힙니다 (.gitignore 대상)
# 홈서버(docker compose) 배포용은 deployment/home-server/.env.example 을 참고하세요

# ─────────────────────────────────────────────
# 필수 (기본값 없음)
# ─────────────────────────────────────────────

# OpenAI: 임베딩 검색, 모더레이션, 판매글 이미지 분석, eval
OPENAI_API_KEY=

# JWT 서명 키 (충분히 긴 임의 문자열)
SECURITY_JWT_SECRET=

# Toss Payments (테스트 키 사용 권장)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# OAuth2 소셜 로그인
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 배송 조회 API
DELIVERYAPI_API_KEY=
DELIVERYAPI_SECRET_KEY=

# Gmail SMTP 앱 비밀번호 (APP_MAIL_ENABLED=false 면 비워도 됨)
MAIL_APP_PASSWORD=

# ─────────────────────────────────────────────
# 선택 (주석 처리된 값이 기본값, 바꿀 때만 주석 해제)
# ─────────────────────────────────────────────

# 서비스 주소 / CORS
# APP_PUBLIC_ORIGIN=http://localhost:5173
# APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:5173
# APP_UPLOAD_DIR=./uploads

# MariaDB
# MARIADB_HOST=localhost
# MARIADB_PORT=3306
# MARIADB_DATABASE=reform
# MARIADB_USER=reform
# MARIADB_PASSWORD=

# PostgreSQL + PGVector
# POSTGRES_URL=jdbc:postgresql://localhost:5432/reform_vector
# POSTGRES_USERNAME=postgres
# POSTGRES_PASSWORD=postgres
# PGVECTOR_INITIALIZE_SCHEMA=false
# APP_AI_VECTOR_ENABLED=true

# Redis
# REDIS_HOST=localhost
# REDIS_PORT=6379

# 메일
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# APP_MAIL_FROM=
# APP_MAIL_ENABLED=true
# APP_AUTH_LOGIN_CODE_DELIVERY_MODE=mail

# OAuth 리다이렉트 (기본값은 APP_PUBLIC_ORIGIN 기준)
# KAKAO_REDIRECT_URI=
# GOOGLE_REDIRECT_URI=
# APP_AUTH_OAUTH_SUCCESS_REDIRECT_URI=
# APP_AUTH_OAUTH_FAILURE_REDIRECT_URI=

# Spring Batch / 더미 데이터
# SPRING_BATCH_INITIALIZE_SCHEMA=always
# APP_DUMMY_SQL_ENABLED=false
# APP_DUMMY_SQL_FORCE=false
# APP_DUMMY_SQL_SYNC_PASSWORDS=false
